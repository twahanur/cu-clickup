{
  "name": "clickup-flow",
  "description": "Keep ClickUp in sync while you code: your AI plans the day, starts and finishes tasks, logs commits and answers who is working on what.",
  "version": "1.3.3",
  "author": {
    "name": "Twahanur Rahman"
  },
  "homepage": "https://github.com/twahanur/cu-clickup",
  "repository": "https://github.com/twahanur/cu-clickup",
  "license": "MIT",
  "keywords": [
    "clickup",
    "tasks",
    "git",
    "productivity",
    "mcp"
  ],
  "mcpServers": {
    "clickup-flow": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/cu.js",
        "mcp"
      ]
    }
  }
}
