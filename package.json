    "git-hooks",
    "task-tracking",
    "claude-code",
    "clickup-cli",
    "productivity"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twahanur/cu-clickup.git"
  },
  "homepage": "https://github.com/twahanur/cu-clickup#readme",
  "bugs": {
    "url": "https://github.com/twahanur/cu-clickup/issues"
  },
  "author": "Twahanur Rahman",
  "cuInstall": "cusync"
