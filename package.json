{
  "name": "clickup-flow",
  "version": "1.3.3",
  "description": "Keep ClickUp in sync from your terminal, git and AI agents (Claude Code, Cursor, MCP): plan the day, start/finish tasks, log every commit, see who works on what.",
  "type": "module",
  "bin": {
    "cu": "bin/cu.js",
    "clickup-flow": "bin/cu.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node scripts/test.js",
    "build:skill": "node scripts/build-skill.js"
  },
  "keywords": [
    "clickup",
    "cli",
    "git-hooks",
    "task-tracking",
    "claude-code",
    "clickup-cli",
    "productivity",
    "mcp",
    "mcp-server",
    "ai-agent",
    "cursor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twahanur/cu-clickup.git"
  },
  "homepage": "https://github.com/twahanur/cu-clickup#readme",
  "bugs": {
    "url": "https://github.com/twahanur/cu-clickup/issues"
  },
  "author": "Twahanur Rahman",
  "cuInstall": "clickup-flow"
}
